# Two local env files, loaded by loadEnv.ts (see that file for exactly how):
#
# - .env.development — for local dev/testing. Leave TURSO_DATABASE_URL,
#   TURSO_AUTH_TOKEN, RESEND_API_KEY, and RESEND_FROM_EMAIL blank/unset here
#   on purpose: db.ts then falls back to a local SQLite file
#   (server/data/buckets.db) instead of production Turso, and email.ts
#   skips sending instead of hitting Resend for real. Only
#   GOLF_COURSE_API_KEY needs a real value (safe to reuse the same key —
#   it's just course search, no user data). This is what `npm run dev`
#   uses whenever this file exists.
# - .env — production-mirror, real Turso/Resend credentials. Not read by
#   `npm run dev` as long as .env.development exists; kept around for
#   one-off scripts that intentionally talk to production, like
#   scripts/admin-reset-password.ts. Render itself doesn't read this file
#   at all — production env vars are set directly on the Render dashboard.
#
# Neither file is committed (see ../.gitignore); this .env.example is just
# the template for both.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOLF_COURSE_API_KEY=
